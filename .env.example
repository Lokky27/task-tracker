#======================================
# Database Configuration
#======================================
DB_URL=jdbc:postgresql://localhost:5432/task_tracker_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=5432
DB_NAME=task_tracker_db

#======================================
# Liquibase Configuration
#======================================
LIQUIBASE_CONTEXTS=local, dev-data
LIQUIBASE_CHANGELOG=classpath:/db/changelog/master-all-services.yaml
LIQUIBASE_LOG_LEVEL=INFO
LIQUIBASE_DROP_FIRST=false
LIQUIBASE_TEST_ROLLBACK=false

#======================================
# Application Configuration
#======================================
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
SERVER_PORT=8090
SPRING_PROFILES_ACTIVE=local

#======================================
# External Services (for development)
#======================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379

#======================================
# Security (development values)
#======================================
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=ptms-local
KEYCLOAK_CLIENT_ID=ptms-client
KEYCLOAK_CLIENT_SECRET=local-secret-123

#======================================
# Monitoring
#======================================
PROMETHEUS_ENABLED=true
GRAFANA_URL=http://localhost:3000